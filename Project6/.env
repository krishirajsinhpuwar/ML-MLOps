STORAGE_BACKEND=lakefs

RAW_DATA_DIR=data/raw

LOCAL_STORAGE_DIR=data/output-local
RUSTFS_STORAGE_DIR=data/output-s3
LAKEFS_STORAGE_DIR=data/output-lakefs

RUSTFS_LOGS_DIR=logs

RUSTFS_BUCKET=bucket
RUSTFS_ENDPOINT_PORT=9000
RUSTFS_WEB_SERVER_UI_PORT=9001
RUSTFS_ENDPOINT_URL=http://localhost:${RUSTFS_ENDPOINT_PORT}
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=admin

MLFLOW_EXPERIMENT_NAME=bike-rental-demand
MLFLOW_ENDPOINT_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:${MLFLOW_ENDPOINT_PORT}
MLFLOW_REGISTERED_MODEL_NAME=xgboost-log1p-bike-rental-demand
MLFLOW_BACKEND_STORE_URI=sqlite:///mlflow.db

LAKEFS_REPO=repo
LAKEFS_ENDPOINT_PORT=8000
LAKEFS_ENDPOINT_URL=http://localhost:${LAKEFS_ENDPOINT_PORT}
LAKEFS_ACCESS_KEY=admin
LAKEFS_SECRET_KEY=admin
LAKEFS_SOURCE_BRANCH=main
LAKEFS_OUTPUT_BRANCH=output

LAKEFS_STORAGE_NAMESPACE=s3://${RUSTFS_BUCKET}/${LAKEFS_REPO}

# Bonus: set to true to ship the auto-retrain sensor running, so the
# pipeline retrains whenever new data is committed to the LakeFS source
# branch. Off by default; can also be toggled in the Dagster UI. See README.
RETRAIN_ON_DATA_CHANGE=false
